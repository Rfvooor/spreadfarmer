# Polymarket credentials
PRIVATE_KEY=your_private_key_here
FUNDER_ADDRESS=your_polymarket_profile_address

# Optional: API credentials (will be derived if not provided)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Rebate Farmer Config
CAPITAL_USD=100
REBATE_POOL_PERCENT=1.0  # 100% of taker fees redistributed as maker rebates
MIN_EDGE_USD=0.01        # Minimum expected value to place a quote
MAX_UNREALIZED_LOSS_USD=20
MAX_EXPOSURE_USD=500
PANIC_TIME_SEC=60

# Imbalance Handling
IMBALANCE_HOLD_MS=5000        # Hold time (ms) before selling imbalanced side (default: 5s)
IMBALANCE_STOP_LOSS_PCT=0.15  # Stop loss as % of cost basis (default: 15%)

# Spread Trader Config
MARKET_TYPE=all          # 15m, 5m, or all
MARGIN_FROM_MID=0.02
ORDER_SIZE_USD=50
MIN_SPREAD_TO_ENTER=0.02
TIME_TO_EXPIRE_SEC=120
MAX_LOSS_PCT=0.05
MAX_ACTIVE_POSITIONS=10
POLL_INTERVAL_MS=1000
ENABLE_BID_SIDE=true     # Buy both sides when bid sum < $1
ENABLE_ASK_SIDE=true     # Sell both sides when ask sum > $1
PRE_SPLIT_USD=100        # USDC to split for ASK inventory

# ============================================================================
# VOLATILITY LADDER (Merge Arbitrage) Config
# ============================================================================

# Entry
VL_SEED_SIZE_PCT=0.25          # 25% of max position for initial seed
VL_SEED_OFFSET_TICKS=1         # Place seed order +1 tick from mid
VL_SEED_TIMEOUT_SEC=60         # Cancel seed if not filled in 60s
VL_MIN_VIABLE_POSITION=10      # Minimum shares to proceed (accept partial fill)

# Core Strategy
VL_MERGE_THRESHOLD=0.96        # Target PAIR_COST (avg_cost_up + avg_cost_down)
VL_MARKET_TYPE=15m             # Only 15m markets for this strategy

# Risk Management
VL_MAX_POSITION_SIZE=100       # Max shares per side
VL_MAX_TOTAL_SPEND=105         # Max USDC to spend per trade
VL_MAX_LOSS_PER_TRADE=10       # Hard stop loss per trade
VL_MAX_CONCURRENT_MARKETS=3    # Max simultaneous positions

# Exit Timing
VL_TIME_STOP_SEC=120           # Exit if PAIR_COST > threshold with <120s left
VL_FORCE_EXIT_SEC=60           # Force exit with <60s remaining

# Market Quality Filters
VL_MAX_ENTRY_SPREAD=0.10       # Skip if bid-ask spread > 10%
VL_MAX_DIRECTIONAL_BIAS=0.15   # Skip if |mid - 0.50| > 0.15
VL_MIN_ORDER_BOOK_DEPTH=20     # Min size on best bid/ask

# Order Management
VL_ORDER_TIMEOUT_SEC=30        # Cancel stale orders after 30s
VL_REPOSITION_THRESHOLD=0.02   # Reposition if price moves 2 ticks
VL_MIN_PAIR_COST_IMPROVEMENT=0.01  # Only accumulate if improves by 1 cent

# Polling
VL_POLL_INTERVAL_MS=1000       # Check every 1 second
